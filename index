<span class="line-comment"># Если нашли — вызываем</span>
<span class="line"><span class="line-num">54</span><span class="line-code">        <span class="kw">else</span>:</span></span>
<span class="line"><span class="line-num">55</span><span class="line-code">            <span class="fn">send_message</span>(vk, peer_id, <span class="str">"Не знаю такую команду. Напиши: помощь"</span>)</span></span>
<span class="line"><span class="line-num">56</span><span class="line-code"></span></span>
<span class="line"><span class="line-num">57</span><span class="line-code"><span class="kw">if</span> __name__ == <span class="str">"__main__"</span>:</span></span>
