<section id="l2-listen">
  <h3>2.10 Получение событий</h3>
  <div class="code-block">
    <div class="code-header"><span class="filename">Цикл обработки событий</span></div>
<pre>
<span class="line"><span class="line-num">1</span><span class="line-code">    <span class="kw">for</span> event <span class="kw">in</span> longpoll.<span class="fn">listen</span>():</span></span>
<span class="line-comment"># listen() — бесконечный генератор событий. Цикл for будет крутиться вечно,</span>
<span class="line-comment"># получая новые события по мере их появления</span>
<span class="line"><span class="line-num">2</span><span class="line-code">        <span class="kw">if</span> event.type != VkBotEventType.MESSAGE_NEW:</span></span>
<span class="line-comment"># Проверяем тип события. Если это НЕ новое сообщение — пропускаем</span>
<span class="line-comment"># (могут приходить события о лайках, подписках и т.д.)</span>
<span class="line"><span class="line-num">3</span><span class="line-code">            <span class="kw">continue</span></span></span>
<span class="line-comment"># continue — перейти к следующей итерации цикла, игнорируя остальной код</span>
<span class="line"><span class="line-num">4</span><span class="line-code"></span></span>
<span class="line"><span class="line-num">5</span><span class="line-code">        message = event.object.message</span></span>
<span class="line-comment"># event.object — объект события, а .message — вложенный словарь с данными сообщения</span>
<span class="line"><span class="line-num">6</span><span class="line-code"></span></span>
<span class="line"><span class="line-num">7</span><span class="line-code">        text = message.<span class="fn">get</span>(<span class="str">"text"</span>, <span class="str">""</span>).<span class="fn">strip</span>().<span class="fn">lower</span>()</span></span>
<span class="line-comment"># .get("text", "") — безопасно достаём текст (если его нет — пустая строка)</span>
<span class="line-comment"># .strip().lower() — убираем пробелы и приводим к нижнему регистру</span>
<span class="line"><span class="line-num">8</span><span class="line-code"></span></span>
<span class="line"><span class="line-num">9</span><span class="line-code">        peer_id = message[<span class="str">"peer_id"</span>]</span></span>
<span class="line-comment"># peer_id — кому отвечать. В личных сообщениях это ID пользователя</span>
<span class="line"><span class="line-num">10</span><span class="line-code"></span></span>
<span class="line"><span class="line-num">11</span><span class="line-code">        <span class="kw">if</span> text <span class="kw">in</span> (<span class="str">"начать"</span>, <span class="str">"start"</span>, <span class="str">"привет"</span>):</span></span>
<span class="line-comment"># Проверяем: если текст совпадает с одним из приветствий (кортеж строк)</span>
<span class="line"><span class="line-num">12</span><span class="line-code">            <span class="fn">send_message</span>(vk, peer_id, <span class="str">"Привет! Я бот сообщества VK."</span>)</span></span>
<span class="line"><span class="line-num">13</span><span class="line-code">        <span class="kw">elif</span> text == <span class="str">"помощь"</span>:</span></span>
<span class="line-comment"># elif = else if — следующая проверка, если первая не сработала</span>
<span class="line"><span class="line-num">14</span><span class="line-code">            <span class="fn">send_message</span>(vk, peer_id, <span class="str">"Команды: привет, помощь, кто ты"</span>)</span></span>
<span class="line"><span class="line-num">15</span><span class="line-code">        <span class="kw">elif</span> text == <span class="str">"кто ты"</span>:</span></span>
<span class="line"><span class="line-num">16</span><span class="line-code">            <span class="fn">send_message</span>(vk, peer_id, <span class="str">"Я учебный Python-бот."</span>)</span></span>
</pre>
  </div>
</section>

