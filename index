<span class="line"><span class="line-num"> 5</span><span class="line-code">}</span></span>
<span class="line"><span class="line-num"> 6</span><span class="line-code"></span></span>
<span class="line"><span class="line-num"> 7</span><span class="line-code"><span class="kw">def</span> <span class="fn">normalize</span>(text):</span></span>
