<span class="line"><span class="line-num">3</span><span class="line-code">        <span class="kw">raise</span> <span class="fn">RuntimeError</span>(<span class="str">"Заполните VK_GROUP_TOKEN и VK_GROUP_ID в .env"</span>)</span></span>
<span class="line-comment"># raise — выбрасываем исключение (ошибку). Программа остановится с понятным сообщением</span>
<span class="line"><span class="line-num">4</span><span class="line-code"></span></span>
<span class="line"><span class="line-num">5</span><span class="line-code">    vk_session = vk_api.<span class="fn">VkApi</span>(token=TOKEN)</span></span>
